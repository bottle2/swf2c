.PDF_WWW_LINK https://www.newgrounds.com/portal/view/624750 "Samsara Room (2013)"
.\" Cansei
.LIST OFF
.\" XXX MDT requires either 1.5 cm between title and entries, or an empty line
.\"     which is 2 * 12 * 1.2 * 1.5 * 2.54 / 72 = 1.524 cm
.da TOC_ENTRIES
.\" Stuff seems reversed here. Go figure hahaha.
\!.COLLATE
\!.PAGINATE OFF
\!.NO_SHIM
\!.NO_FLEX
\!.MSWORD_SIMPLE_12
\!.START
\!.pdfbookmark 1 "Lista de símbolos"
\!.CENTER
\!\fBLISTA DE SÍMBOLOS\fR
\!.MSWORD_ONEHALF_12
\!.SPACE
\!.SPACE
\!.JUSTIFY
\!.SILENT
.\" XXX Write longest symbol here!! 
\!.PAD "\*[ST1]GHz\*[ST1X]\ \ \*[ST2]#\*[ST2X]"
\!.SILENT OFF
\!.ST 1 L
\!.ST 2 L QUAD
\!.Simbolo GHz Gigahertz
\!.Simbolo ms Milissegundo
\!.COLLATE
\!.NO_SHIM
\!.NO_FLEX
\!.MSWORD_SIMPLE_12
\!.START
\!.pdfbookmark 1 "Lista de abreviaturas e siglas"
\!.CENTER
\!\fBLISTA DE ABREVIATURAS E SIGLAS\fR
\!.MSWORD_ONEHALF_12
\!.SPACE
\!.SPACE
\!.JUSTIFY
\!.SILENT
.\" XXX Write longest acronym here!! 
\!.PAD "\*[ST1]SWF\*[ST1X]\ \ \*[ST2]#\*[ST2X]"
\!.SILENT OFF
\!.ST 1 L
\!.ST 2 L QUAD
\!.Sigla SWF ShockWave File ou Small Web Format
\!.Sigla GCC Gnu Compiler Collection
\!.TQ
